{
  "name": "etebase",
  "version": "0.43.0",
  "description": "Etebase TypeScript API for the web and node",
  "type": "commonjs",
  "main": "dist/lib-cjs/Etebase.js",
  "module": "dist/lib/Etebase.js",
  "browser": "dist/umd/Etebase.js",
  "files": [
    "dist/**/*",
    "!dist/**/*.test.*",
    "!dist/**/TestConstants.*"
  ],
  "types": "dist/lib/Etebase.d.ts",
  "scripts": {
    "build": "tsc && tsc -m commonjs --outDir dist/lib-cjs && webpack",
    "lint": "eslint src",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm test && npm run lint"
  },
  "dependencies": {
    "@msgpack/msgpack": "^1.12.2",
    "@types/urijs": "^1.19.26",
    "argon2-webworker": "^0.1.1",
    "isomorphic-ws": "^5.0.0",
    "libsodium-wrappers": "0.7.6",
    "node-fetch": "^2.7.0",
    "reconnecting-websocket": "^4.4.0",
    "urijs": "^1.19.11",
    "ws": "^7.5.13"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/jest": "^30.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.6.5",
    "babel-jest": "^30.5.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "react-native-sodium": "^0.4.0",
    "ts-loader": "^9.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "dist"
    ]
  },
  "keywords": [
    "Etebase",
    "encryption",
    "crypto",
    "synchronization"
  ],
  "author": "Tom Hacohen",
  "repository": "https://github.com/nikossvnk/etebase-js",
  "license": "BSD-3-Clause"
}
